# Types for the PyYAML calls this repo makes; PyYAML ships no stubs, and pyright reads typings/.
from typing import Any

class YAMLError(Exception): ...
class SafeLoader: ...
class CSafeLoader(SafeLoader): ...

def load(stream: str | bytes, Loader: type[SafeLoader]) -> Any: ...
def safe_load(stream: str | bytes) -> Any: ...
def safe_dump(
    data: Any,
    stream: None = None,
    *,
    sort_keys: bool = ...,
    allow_unicode: bool = ...,
    width: int = ...,
    default_flow_style: bool | None = ...,
) -> str: ...
