{
  "id": "bad-deploy",
  "title": "checkout v1.8.0 throws on bundle carts and raises the 5xx ratio",
  "seed": 1801,
  "alert": {
    "labels": {
      "alertname": "CheckoutHighErrorRate",
      "service": "checkout",
      "severity": "critical"
    },
    "annotations": {
      "summary": "checkout 5xx ratio above 5% for 2 minutes",
      "description": "http_error_ratio{service=\"checkout\"} > 0.05 for 2m"
    }
  },
  "services": {
    "frontend": { "depends_on": ["checkout", "catalog"] },
    "checkout": { "depends_on": ["payments", "orders-db", "catalog"] },
    "payments": {},
    "catalog": {},
    "orders-db": {}
  },
  "deploys": [
    {
      "service": "checkout",
      "version": "v1.8.0",
      "previous_version": "v1.7.3",
      "at": "-6m",
      "author": "ci-bot",
      "change": "Rework cart total calculation for bundle discounts (PR #4812)"
    },
    {
      "service": "frontend",
      "version": "v2.3.1",
      "previous_version": "v2.3.0",
      "at": "-50m",
      "author": "ana.lopez",
      "change": "Update header copy and footer links"
    }
  ],
  "background_deploys_days": 7,
  "metrics": [
    {
      "name": "http_requests_per_second",
      "labels": { "service": "checkout" },
      "base": 120,
      "noise": 6
    },
    {
      "name": "http_error_ratio",
      "labels": { "service": "checkout" },
      "base": 0.002,
      "noise": 0.0005,
      "changes": [{ "at": "-5m", "value": 0.14, "ramp": "1m" }]
    },
    {
      "name": "http_latency_p99_seconds",
      "labels": { "service": "checkout" },
      "base": 0.28,
      "noise": 0.02,
      "changes": [{ "at": "-5m", "value": 0.65, "ramp": "1m" }]
    },
    {
      "name": "cpu_usage_ratio",
      "labels": { "service": "checkout" },
      "base": 0.42,
      "noise": 0.03
    },
    {
      "name": "memory_usage_ratio",
      "labels": { "service": "checkout" },
      "base": 0.55,
      "noise": 0.02
    },
    {
      "name": "db_pool_in_use",
      "labels": { "service": "checkout" },
      "base": 12,
      "noise": 2
    },
    {
      "name": "db_pool_max",
      "labels": { "service": "checkout" },
      "base": 50
