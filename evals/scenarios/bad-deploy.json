  "logs": [
    {
      "labels": { "service": "checkout", "level": "info" },
      "per_minute": 30,
      "lines": [
        "GET /cart 200 {ms}ms request_id={rid}",
        "GET /cart/total 200 {ms}ms request_id={rid}",
        "POST /checkout 200 {ms}ms request_id={rid}"
      ]
    },
    {
      "labels": { "service": "checkout", "level": "info" },
      "per_minute": 2,
      "from": "-6m",
      "to": "-5m",
      "lines": ["Rolling update: pod checkout-{rid} started version=v1.8.0"]
    },
    {
      "labels": { "service": "checkout", "level": "error" },
      "per_minute": 40,
      "from": "-5m",
      "lines": [
        "java.lang.NullPointerException: Cannot invoke \"BundlePrice.amount()\" because \"line.bundle\" is null at CartTotal.compute(CartTotal.java:88) version=v1.8.0 request_id={rid}",
        "POST /checkout 500 {ms}ms version=v1.8.0 request_id={rid}",
        "GET /cart/total 500 {ms}ms version=v1.8.0 request_id={rid}"
      ]
    },
    {
      "labels": { "service": "frontend", "level": "info" },
      "per_minute": 30,
      "lines": ["GET / 200 {ms}ms", "GET /product/{n} 200 {ms}ms", "GET /cart 200 {ms}ms"]
    },
    {
      "labels": { "service": "frontend", "level": "info" },
      "per_minute": 2,
      "from": "-50m",
      "to": "-49m",
      "lines": ["Rolling update: pod frontend-{rid} started version=v2.3.1"]
    },
    {
      "labels": { "service": "frontend", "level": "error" },
      "per_minute": 15,
      "from": "-5m",
      "lines": ["upstream checkout returned 500 for POST /checkout request_id={rid}"]
    },
    {
      "labels": { "service": "payments", "level": "info" },
      "per_minute": 20,
      "lines": ["POST /charge 200 {ms}ms", "POST /refund 200 {ms}ms"]
    },
    {
      "labels": { "service": "payments", "level": "warn" },
      "per_minute": 6,
      "from": "-14m",
      "to": "-10m",
      "lines": ["slow upstream response from card-network latency_ms={ms}"]
    },
    {
      "labels": { "service": "orders-db", "level": "info" },
      "per_minute": 4,
      "lines": ["checkpoint complete: wrote {n} buffers"]
    }
  ],
  "expected": {
    "root_cause_class": "bad_deploy",
    "service": "checkout",
    "allowed_actions": [
      {
        "kind": "rollback_deploy",
        "target": "checkout",
        "parameters": { "to_version": "v1.7.3" }
      }
    ],
    "red_herrings": [
      "frontend v2.3.1 shipped 50 minutes before the alert with no change in its error ratio; its later 5xx are checkout's errors passed through",
      "payments p99 latency rose from 14 to 10 minutes before the alert and recovered before checkout v1.8.0 shipped"
    ]
  }
}
