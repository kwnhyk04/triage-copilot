# Dependencies and build output
node_modules/
.turbo/
.next/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
# Playwright's output and its saved sign-in (make test-e2e)
test-results/

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Local settings and secrets
.env
.env.*
!.env.example
# make prod-backup's dumps: every report, and the tenants' token hashes.
/backups/

# Private: agent instructions and working notes, kept on this PC and in its backup. The alert
# runbooks (the rules link to them), the guide, the server runbook and the logo files stay public.
/AGENTS.md
/CLAUDE.md
.claude/
docs/*
!docs/alerts.md
!docs/guide.md
!docs/server-move.md
!docs/brand/
!docs/third-party.md

# Eval output: the dated reports are kept, the per-run cache (runs/) is not.
evals/reports/*
!evals/reports/.gitkeep
!evals/reports/*.json
!evals/reports/*.md
