# Copy to .env. The Makefile includes this file, so values must not contain # or $.
# Dev-only values below; real secrets go in .env only, never in the repo.

# Compose profiles to start with the app infra. Set to observability for the collector,
# Jaeger, Prometheus and Grafana.
COMPOSE_PROFILES=

# Host ports, all bound to 127.0.0.1.
POSTGRES_PORT=5434
SQS_PORT=4566
TOXIPROXY_PORT=8476
TOXIPROXY_PROXY_PORTS=15500-15509
OTEL_GRPC_PORT=4337
OTEL_HTTP_PORT=4338
JAEGER_UI_PORT=16688
PROMETHEUS_PORT=9092
GRAFANA_PORT=3201

# Infra credentials. Keep the role passwords in sync with the database URLs below.
POSTGRES_PASSWORD=postgres-dev
GATEWAY_DB_PASSWORD=gateway-dev
AGENT_DB_PASSWORD=agent-dev
GRAFANA_ADMIN_PASSWORD=grafana-dev

# Shared by all services. Log levels: debug, info, warn, error.
LOG_LEVEL=info
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SQS_ENDPOINT_URL=http://127.0.0.1:4566
INVESTIGATIONS_QUEUE=investigations.fifo
# Approved actions (ActionApproved) that the gateway queues for the executor.
ACTIONS_QUEUE=actions.fifo
# StepRecorded and ReportRecorded from the agent; the gateway copies them into its mirror tables.
AGENT_EVENTS_QUEUE=agent-events.fifo
# Agent events the gateway can never store go here at once; make dlq-replay moves them back.
AGENT_EVENTS_DLQ=agent-events-dlq.fifo
# Uncomment with the observability profile to export traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4338

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4200
GATEWAY_DATABASE_URL=postgres://gateway:gateway-dev@127.0.0.1:5434/triage
# X-API-Key, at least 32 characters. The gateway asks for it on every route except the probes, the
# Alertmanager webhook and approve or reject; the web server sends it.
GATEWAY_API_KEY=gateway-dev-api-key-00000000000000
# The gateway's internal listener for the executor. Keep it on 127.0.0.1 (in production, the
# internal Docker network): Tailscale Funnel exposes only the public port.
GATEWAY_INTERNAL_HOST=127.0.0.1
GATEWAY_INTERNAL_PORT=4201
# Bearer token of the internal listener, at least 32 characters. Only the gateway and the executor
# hold it; it differs from AGENT_SERVICE_TOKEN.
EXECUTOR_SERVICE_TOKEN=executor-service-dev-token-0000000
# Requests per minute for each credential, or each client address without one.
RATE_LIMIT_PER_MINUTE=600
# Failed credential checks (401) one client address may make a minute; past it, 429. A key that
# verifies, or a webhook token that verified in the last 10 minutes, is never held back.
AUTH_FAILURES_PER_MINUTE=20
# The proxies in front of the gateway, as addresses or CIDRs (comma-separated): their requests'
# client address comes from X-Forwarded-For. Empty trusts none, so behind Tailscale Funnel every
# client shares the sidecar's address. Never true or a hop count. Production: README, Deploy.
GATEWAY_TRUST_PROXY=
# Investigations one tenant may start within any 5 minutes; later alert groups are kept
# without one (queued_not_investigated).
MAX_NEW_INVESTIGATIONS=5
# And within one UTC day (30 triages a day per app, each app being one tenant). Later groups are
# kept with the reason daily_cap; make digest lists a day's uninvestigated groups.
MAX_DAILY_INVESTIGATIONS=30
# The recovery sweeper asks the agent at AGENT_URL every SWEEPER_INTERVAL_SECONDS. It re-queues
# parked investigations once they can run, and stuck ones: unknown to the agent, or without a step,
# for SWEEPER_STUCK_AFTER_MINUTES.
AGENT_URL=http://127.0.0.1:4210
SWEEPER_INTERVAL_SECONDS=15
SWEEPER_STUCK_AFTER_MINUTES=10

AGENT_HOST=127.0.0.1
AGENT_PORT=4210
AGENT_DATABASE_URL=postgresql+psycopg://agent:agent-dev@127.0.0.1:5434/triage
# true only while investigation_steps is partitioned online (docs/migrations.md, story A).
STEPS_DUAL_WRITE=false
# Messages one agent works on at once, and investigations one tenant runs at once.
AGENT_MAX_IN_FLIGHT=5
AGENT_TENANT_CAP=5
# false stops every model call. New investigations park (waiting for budget) while it is off or
# the model tokens spent today (UTC) reach the budget; others park at their next model turn while
# it is off. The gateway's recovery sweeper re-queues them once model calls are available.
AI_ENABLED=false
DAILY_AI_TOKEN_BUDGET=1000000
# Model tokens one investigation may use, cached input included: thousands, at least 60,000. The
# eval reads it too; off 150,000 a run gets its own cache key and report name, never the exam's.
INVESTIGATION_TOKEN_CAP=150000
# Tenants whose alerts are real incidents, as JSON {"<tenant uuid>": "freight-audit"} (or
# "filing-lens"); empty: every tenant is the sim's. They run only while `make switch NAME=live
# STATE=on` (off by default), on live triage's own prompt, tools, token cap and daily budget. The
# agent and the gateway both read it: each purges these tenants' snapshots and steps after 30 days.
LIVE_TENANTS=
LIVE_INVESTIGATION_TOKEN_CAP=350000
LIVE_DAILY_AI_TOKEN_BUDGET=25000000
# Bearer token of the agent's internal API, at least 32 characters. The gateway sends it, and the
# agent sends it to the gateway's internal listener for alert context.
AGENT_SERVICE_TOKEN=agent-service-dev-token-000000000000
GATEWAY_INTERNAL_URL=http://127.0.0.1:4201
# The scenario engine the read-only tools query.
SIM_URL=http://127.0.0.1:4230
# Model roles. Providers: gemini, anthropic, nvidia, openrouter or ollama; each takes its key from
# its own variable below (ollama needs none). BASE_URL overrides the provider's default endpoint.
# RPM and RPD are the free-tier limits per model (unverified until checked in AI Studio); 0 means
# none. The limiter keeps under them, counting days from midnight Pacific as Google does.
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
LLM_PRIMARY_RPM=10
# Measured, not documented: Google said "daily quota spent" after 275 requests on 2026-10-16.
LLM_PRIMARY_RPD=260
LLM_FALLBACK_PROVIDER=nvidia
LLM_FALLBACK_MODEL=deepseek-ai/deepseek-v4.1-flash
LLM_FALLBACK_RPM=40
LLM_FALLBACK_RPD=0
# Summarizes log pages after the first.
LLM_SMALL_PROVIDER=gemini
LLM_SMALL_MODEL=gemini-3.1-flash-lite
LLM_SMALL_RPM=10
LLM_SMALL_RPD=500
# A 429 or a spent daily quota on the primary moves the turn to the fallback. Evals set false.
LLM_FALLBACK_ON_RATE_LIMIT=true
# true: the sim and evals ask Claude (LLM_TRIAGE_MODEL) first, as live triage does, then the free
# chain above, paid from Anthropic API credits; false (the default) keeps them free. Any failure
# moves its call alone down the chain. Credits gone (402, or a 400 naming the credit balance or a
# spend limit) keep Claude off until the month ends (UTC), a rejected key (401, 403) until the
# agent restarts; from LLM_CLAUDE_UNTIL, the day the credits expire, it is never called.
LLM_CLAUDE_FIRST=false
LLM_CLAUDE_RPM=50
LLM_CLAUDE_UNTIL=2026-11-10
# Live triage asks Claude first (while ANTHROPIC_API_KEY is set, before LLM_CLAUDE_UNTIL), then
# the free chain above. Any Claude call but a plan, evals included, runs only if today's Claude
# spend (UTC) plus its worst case stays within LLM_TRIAGE_DAILY_USD (US dollars); the model must
# have prices in agent/pricing.py.
LLM_TRIAGE_MODEL=claude-haiku-5-5
LLM_TRIAGE_DAILY_USD=0.40
# TC's share of the Anthropic account a calendar month (UTC), in US dollars, evals included: any
# Claude call, in any role, runs only if this month's Claude spend plus its worst case stays within
# it. Every Claude model a role may call must have prices in agent/pricing.py.
LLM_CLAUDE_MONTHLY_USD=15
# A real incident's plan (P2), made once after a real verdict while the planner switch is on
# (`make switch NAME=planner STATE=on`, default off): Claude first while ANTHROPIC_API_KEY is set
# and before LLM_CLAUDE_UNTIL, then the free chain. A Claude plan runs only if today's plans (UTC)
# plus its worst case ($0.48) stay within LLM_PLANNER_DAILY_USD, and inside the monthly cap above.
LLM_PLANNER_MODEL=claude-opus-5-5
LLM_PLANNER_EFFORT=medium
LLM_PLANNER_DAILY_USD=1.00
# Provider keys: real values in .env only. make passes them to the agent alone.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Local embedding model for search_runbooks (fastembed). Must be on H:; only make embed-model
# downloads into it, everything else loads it offline.
FASTEMBED_CACHE_PATH=H:/.cache/fastembed
RUNBOOKS_DIR=runbooks

EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=4220

SIM_HOST=127.0.0.1
SIM_PORT=4230
# The sim's admin routes (activation, state, the down switch) listen on their own port, which only
# the eval harness is given (SIM_ADMIN_URL; the Makefile passes it to make eval and make smoke
# alone). Keep it on 127.0.0.1, or the internal Docker network in production, never published.
SIM_ADMIN_HOST=127.0.0.1
SIM_ADMIN_PORT=4231
SIM_ADMIN_URL=http://127.0.0.1:4231
# Scenario files (world and labels), one YAML file per scenario; a set is never edited in place.
SIM_SCENARIOS_DIR=evals/scenarios/v1
# A query that runs longer answers 400, so no request keeps a sim worker busy.
SIM_REQUEST_TIME_LIMIT_SECONDS=2.0

# watch polls FreightAudit (FA) and FilingLens (FL) and posts their state changes to the production
# gateway's webhook at WATCH_GATEWAY_URL (make prod-up; set http://127.0.0.1:4200 for the dev
# gateway); make dev-watch runs it. An app is watched only when its tenant's webhook token is set
# (make prod-token NAME=<tenant>). Put that tenant in LIVE_TENANTS first, or the agent would
# investigate its alerts with the sim's tools.
WATCH_HOST=127.0.0.1
WATCH_PORT=4240
WATCH_GATEWAY_URL=http://127.0.0.1:4202
# Seconds between polls; a failed health check fires after three polls and resolves after two.
WATCH_INTERVAL_SECONDS=30
# Per app: prod, or dev once that dev stack opts in. Health URLs are JSON by catalog service, with
# no credentials or query string, such as {"api": "https://<FA funnel host>/readyz"}. The repo
# gives origin/main's commits as last fetched (watch never fetches). The Prometheus URL is a dev
# stack's own (FA 9090, FL 9091). Tokens: real values in .env only; make passes them to watch alone.
WATCH_FA_TOKEN=
WATCH_FA_STACK=prod
WATCH_FA_HEALTH_URLS=
WATCH_FA_REPO=
WATCH_FA_PROMETHEUS_URL=
WATCH_FL_TOKEN=
WATCH_FL_STACK=prod
WATCH_FL_HEALTH_URLS=
WATCH_FL_REPO=
WATCH_FL_PROMETHEUS_URL=

WEB_PORT=3200
GATEWAY_URL=http://127.0.0.1:4200

# Approver key, at least 32 characters. The gateway checks it on approve and reject; only the web
# server sends it. make passes it to the gateway and web alone, never to the agent, executor or sim.
APPROVER_API_KEY=approver-dev-key-0000000000000000

# The web's one sign-in. next start and Vercel need both; in next dev it is both or neither, and
# without them sign-in is off. Make them with the web's scripts, which print nothing secret:
#   pnpm --filter @triage/web hash-password --write-env   (writes the hash, each $ doubled for make)
#   pnpm --filter @triage/web session-secret
# For Vercel, run hash-password without --write-env and paste the hash it prints.
LOGIN_PASSWORD_HASH=
SESSION_SECRET=

# Browser tests (make test-e2e): Playwright's browsers on H:, and the three local ports, all on
# 127.0.0.1. CI drops PLAYWRIGHT_BROWSERS_PATH.
PLAYWRIGHT_BROWSERS_PATH=H:\.cache\ms-playwright
E2E_WEB_PORT=3202
E2E_ISOLATED_PORT=3203
E2E_GATEWAY_PORT=4250

# Production (make prod-up; README, Deploy): compose project triagecopilot-prod, with its own
# database and queue. Its values live in three files of their own, never committed (.gitignore
# covers .env.*), each secret made fresh, never one of the dev values above:
#   .env.prod          compose's own: PROD_POSTGRES_PASSWORD, PROD_GATEWAY_DB_PASSWORD,
#                      PROD_AGENT_DB_PASSWORD, TC_IMAGES (ghcr.io/<owner>), TC_TAG (sha-<12>),
#                      TS_AUTHKEY (a tagged, pre-approved Tailscale auth key)
#   .env.prod.gateway  the gateway's: GATEWAY_API_KEY, APPROVER_API_KEY, AGENT_SERVICE_TOKEN,
#                      EXECUTOR_SERVICE_TOKEN, LIVE_TENANTS, and after its check
#                      GATEWAY_TRUST_PROXY=10.231.233.18 (the Funnel sidecar's fixed address)
#   .env.prod.agent    the agent's: the same AGENT_SERVICE_TOKEN, AI_ENABLED=true, ANTHROPIC_API_KEY,
#                      GEMINI_API_KEY, NVIDIA_API_KEY, LIVE_TENANTS
# Production's only published port, on 127.0.0.1: watch posts here, and the egress proxy forwards
# it to the gateway, which has no route out and no port of its own.
PROD_GATEWAY_PORT=4202
