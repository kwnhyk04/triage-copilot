{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvestigationRequested",
  "description": "Body of a message on investigations.fifo. The MessageGroupId is the alert group key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "investigation_id", "group_key", "requested_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "investigation_id": { "type": "string", "format": "uuid" },
    "group_key": { "type": "string", "minLength": 1 },
    "requested_at": { "type": "string", "format": "date-time" }
  }
}
