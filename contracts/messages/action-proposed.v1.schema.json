{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionProposedV1",
  "description": "Agent to gateway: a remediation the agent proposes. Nothing runs until a human approves it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "investigation_id",
    "kind",
    "target",
    "parameters",
    "rationale",
    "proposed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "action_id": { "type": "string", "format": "uuid" },
    "investigation_id": { "type": "string", "format": "uuid" },
    "kind": {
      "type": "string",
      "enum": ["rollback_deploy", "restart_service", "scale_service", "disable_feature_flag"],
      "description": "Allowlisted action kinds; any other kind fails validation."
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Service the action applies to."
    },
    "parameters": {
      "type": "object",
      "additionalProperties": { "type": ["string", "integer", "number", "boolean"] },
      "description": "Kind-specific arguments, for example {\"to_version\": \"v1.7.3\"}."
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "proposed_at": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "schema_version": 1,
      "action_id": "9f8b6c1e-3d2a-4f5b-8e7d-6c5b4a392817",
      "investigation_id": "1b4e28ba-2fa1-41d2-883f-0016d3cca427",
      "kind": "rollback_deploy",
      "target": "checkout",
      "parameters": { "to_version": "v1.7.3" },
      "rationale": "Errors started two minutes after v1.8.0 shipped and only on pods running it (tc_01J9ZK3Q7M).",
      "proposed_at": "2026-10-14T12:01:30Z"
    }
  ]
}
