{
  "name": "@triage/gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import ./src/telemetry.ts src/main.ts",
    "start": "node --import ./src/telemetry.ts src/main.ts",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:int": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --config jest.int.config.js",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "tenant:token": "node src/cli.ts tenant-token",
    "outbox:replay": "node src/cli.ts outbox-replay",
    "events:replay": "node src/cli.ts events-replay",
    "digest": "node src/cli.ts digest",
    "demo:save": "node src/cli.ts demo-save"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1150.0",
    "@fastify/rate-limit": "^11.2.1",
    "@triage/ts-clients": "workspace:*",
    "@triage/ts-config": "workspace:*",
    "@triage/ts-telemetry": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2"
  }
}
